generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
  REQUESTER
  SALES
  ENGINEERING
  AA
}

enum SaleOrderStatus {
  INQUIRY
  DRAWING
  BOQ
  SUBMIT_TO_SALE
  CONFIRM_PO
  CANCELLED
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  username      String?      @unique
  passwordHash  String
  role          Role         @default(REQUESTER)
  active        Boolean      @default(true)
  telegramChatId String?
  createdAt     DateTime     @default(now())
  requested     WorkOrder[]  @relation("requestedBy")
  assigned      WorkOrder[]  @relation("assignedTo")
  comments      Comment[]
  saleOrdersCreated  SaleOrder[]        @relation("saleOrderCreatedBy")
  saleOrdersAssigned SaleOrder[]        @relation("saleOrderAssignedTo")
  saleOrderComments  SaleOrderComment[]
  notifications Notification[]
  sites         UserSite[]
}

model Site {
  id         String      @id @default(cuid())
  name       String      @unique
  address    String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  users      UserSite[]
  assets     Asset[]
  workOrders WorkOrder[]
  saleOrders SaleOrder[]
}

model UserSite {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String

  @@unique([userId, siteId])
}

model Asset {
  id           String       @id @default(cuid())
  name         String
  tag          String       @unique
  location     String?
  category     String?
  status       String       @default("ACTIVE")
  installDate  DateTime?
  notes        String?
  createdAt    DateTime     @default(now())
  site         Site         @relation(fields: [siteId], references: [id])
  siteId       String
  workOrders   WorkOrder[]
  pmSchedules  PMSchedule[]
}

model WorkOrder {
  id            String          @id @default(cuid())
  title         String
  description   String
  status        WorkOrderStatus @default(OPEN)
  priority      Priority        @default(MEDIUM)
  source        String          @default("MANUAL")
  site          Site            @relation(fields: [siteId], references: [id])
  siteId        String
  asset         Asset?          @relation(fields: [assetId], references: [id])
  assetId       String?
  requestedBy   User            @relation("requestedBy", fields: [requestedById], references: [id])
  requestedById String
  assignedTo    User?           @relation("assignedTo", fields: [assignedToId], references: [id])
  assignedToId  String?
  pmSchedule    PMSchedule?     @relation(fields: [pmScheduleId], references: [id])
  pmScheduleId  String?
  createdAt     DateTime        @default(now())
  dueDate       DateTime?
  completedAt   DateTime?
  comments      Comment[]
}

model Comment {
  id          String    @id @default(cuid())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  workOrderId String
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String
  body        String
  createdAt   DateTime  @default(now())
}

model PMSchedule {
  id             String      @id @default(cuid())
  name           String
  asset          Asset       @relation(fields: [assetId], references: [id])
  assetId        String
  frequencyDays  Int
  taskTemplate   String
  active         Boolean     @default(true)
  lastGeneratedAt DateTime?
  nextDueAt      DateTime
  createdAt      DateTime    @default(now())
  workOrders     WorkOrder[]
}
model Notification {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  message     String
  workOrderId String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
}
model SaleOrder {
  id            String            @id @default(cuid())
  title         String
  customerName  String
  description   String?
  status        SaleOrderStatus   @default(INQUIRY)
  value         Float?
  dueDate       DateTime?
  site          Site              @relation(fields: [siteId], references: [id])
  siteId        String
  createdBy     User              @relation("saleOrderCreatedBy", fields: [createdById], references: [id])
  createdById   String
  assignedTo    User?             @relation("saleOrderAssignedTo", fields: [assignedToId], references: [id])
  assignedToId  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  comments      SaleOrderComment[]
}

model SaleOrderComment {
  id          String    @id @default(cuid())
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id])
  saleOrderId String
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String
  body        String
  createdAt   DateTime  @default(now())
}