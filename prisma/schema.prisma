generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  REQUESTER
  MAINTENANCE_LEADER
  MAINTENANCE_TECHNICIAN
  TNC_LEADER
  TNC_ENGINEER
  SALES_LEADER
  SALES_ENGINEER
  QC_LEADER
  QC_ENGINEER
  SHOP_DRAWING_LEADER
  SHOP_DRAWING_ENGINEER
  ANA_LEADER
  ANA_ENGINEER
}

enum TeamCategory {
  SALES
  PROJECT
  MAINTENANCE
}

enum ContractType {
  DLP
  MAINTENANCE
}

enum ServiceRequestStatus {
  REQUEST
  CHECK
  REPORT
  CLOSE
}

enum SaleOrderStatus {
  INQUIRY
  DRAWING
  BOQ
  SUBMIT_TO_SALE
  CONFIRM_PO
  CANCELLED
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  username      String?      @unique
  passwordHash  String
  role          Role         @default(REQUESTER)
  active        Boolean      @default(true)
  pendingApproval Boolean    @default(false)
  telegramChatId String?
  teamId       String?
  team         Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  leadingTeams Team[]   @relation("TeamLeader")
  createdAt     DateTime     @default(now())
  requested     WorkOrder[]  @relation("requestedBy")
  assigned      WorkOrder[]  @relation("assignedTo")
  comments      Comment[]
  workOrderPhotos WorkOrderPhoto[]
  saleOrdersCreated  SaleOrder[]        @relation("saleOrderCreatedBy")
  saleOrdersAssigned SaleOrder[]        @relation("saleOrderAssignedTo")
  saleOrderComments  SaleOrderComment[]
  serviceRequestsCreated  ServiceRequest[]        @relation("serviceRequestCreatedBy")
  serviceRequestsAssigned ServiceRequest[]        @relation("serviceRequestAssignedTo")
  serviceRequestComments  ServiceRequestComment[]
  notifications Notification[]
  sites         UserSite[]
}

model Site {
  id         String      @id @default(cuid())
  name       String      @unique
  address    String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  users      UserSite[]
  assets     Asset[]
  workOrders WorkOrder[]
}

model UserSite {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String

  @@unique([userId, siteId])
}

model Asset {
  id           String       @id @default(cuid())
  name         String
  tag          String       @unique
  location     String?
  category     String?
  status       String       @default("ACTIVE")
  installDate  DateTime?
  notes        String?
  createdAt    DateTime     @default(now())
  site         Site         @relation(fields: [siteId], references: [id])
  siteId       String
  workOrders   WorkOrder[]
  pmSchedules  PMSchedule[]
}

model WorkOrder {
  id            String          @id @default(cuid())
  title         String
  description   String
  status        WorkOrderStatus @default(OPEN)
  priority      Priority        @default(MEDIUM)
  source        String          @default("MANUAL")
  site          Site            @relation(fields: [siteId], references: [id])
  siteId        String
  asset         Asset?          @relation(fields: [assetId], references: [id])
  assetId       String?
  requestedBy   User            @relation("requestedBy", fields: [requestedById], references: [id])
  requestedById String
  assignedTo    User?           @relation("assignedTo", fields: [assignedToId], references: [id])
  assignedToId  String?
  pmSchedule    PMSchedule?     @relation(fields: [pmScheduleId], references: [id])
  pmScheduleId  String?
  createdAt     DateTime        @default(now())
  dueDate       DateTime?
  completedAt   DateTime?
  archived      Boolean         @default(false)
  category      TeamCategory?
  teamId        String?
  team          Team?           @relation(fields: [teamId], references: [id])
  partsNeeded   String?
  warrantyClaim Boolean         @default(false)
  comments      Comment[]
  photos        WorkOrderPhoto[]
}

model WorkOrderPhoto {
  id          String    @id @default(cuid())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  workOrderId String
  url         String
  fileName    String
  uploadedBy  User      @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt   DateTime  @default(now())
}
model Comment {
  id          String    @id @default(cuid())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  workOrderId String
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String
  body        String
  createdAt   DateTime  @default(now())
}

model PMSchedule {
  id             String      @id @default(cuid())
  name           String
  asset          Asset       @relation(fields: [assetId], references: [id])
  assetId        String
  frequencyDays  Int
  taskTemplate   String
  active         Boolean     @default(true)
  lastGeneratedAt DateTime?
  nextDueAt      DateTime
  createdAt      DateTime    @default(now())
  workOrders     WorkOrder[]
}
model Notification {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  message     String
  workOrderId String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
}
model SaleOrder {
  id            String            @id @default(cuid())
  title         String
  customerName  String
  description   String?
  status        SaleOrderStatus   @default(INQUIRY)
  value         Float?
  dueDate       DateTime?
  isCorporatePartner Boolean      @default(false)
  archived      Boolean           @default(false)
  category      TeamCategory?     @default(SALES)
  teamId        String?
  team          Team?             @relation(fields: [teamId], references: [id])
  createdBy     User              @relation("saleOrderCreatedBy", fields: [createdById], references: [id])
  createdById   String
  assignedTo    User?             @relation("saleOrderAssignedTo", fields: [assignedToId], references: [id])
  assignedToId  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  comments      SaleOrderComment[]
}

model SaleOrderComment {
  id          String    @id @default(cuid())
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id])
  saleOrderId String
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String
  body        String
  createdAt   DateTime  @default(now())
}
model ServiceRequest {
  id            String                @id @default(cuid())
  title         String
  customerName  String
  description   String?
  status        ServiceRequestStatus  @default(REQUEST)
  dueDate       DateTime?
  archived      Boolean               @default(false)
  isCorporatePartner Boolean          @default(false)
  soNumber      String?
  category      TeamCategory?         @default(MAINTENANCE)
  teamId        String?
  team          Team?                 @relation(fields: [teamId], references: [id])
  createdBy     User                  @relation("serviceRequestCreatedBy", fields: [createdById], references: [id])
  createdById   String
  assignedTo    User?                 @relation("serviceRequestAssignedTo", fields: [assignedToId], references: [id])
  assignedToId  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  comments      ServiceRequestComment[]
}

model ServiceRequestComment {
  id                String          @id @default(cuid())
  serviceRequest    ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  serviceRequestId  String
  author            User            @relation(fields: [authorId], references: [id])
  authorId          String
  body              String
  createdAt         DateTime        @default(now())
}
model Team {
  id              String            @id @default(cuid())
  name            String            @unique
  category        TeamCategory
  isCrossCategory Boolean           @default(false)
  colorHex        String            @default("#0e5c86")
  teamLeaderId    String?
  teamLeader      User?             @relation("TeamLeader", fields: [teamLeaderId], references: [id])
  members         User[]            @relation("TeamMembers")
  workOrders      WorkOrder[]
  saleOrders      SaleOrder[]
  serviceRequests ServiceRequest[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MaintenanceContract {
  id                String       @id @default(cuid())
  contractType      ContractType
  clientName        String
  siteLocation      String
  originalProjectId String?
  startDate         DateTime
  endDate           DateTime
  contractValue     Float?
  renewalDate       DateTime?
  siteVisitsPerYear Int?
  alert30SentAt     DateTime?
  alert7SentAt      DateTime?
  status            String       @default("ACTIVE")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([endDate])
  @@index([contractType, status])
}