# Postgres connection string (Supabase, Railway, Neon, or your own instance)
DATABASE_URL="postgresql://user:password@host:5432/workorders"

# Direct (non-pooled) connection string, used by Prisma for migrations.
# On providers with connection pooling (e.g. Supabase pgbouncer), this points
# at the direct connection instead of the pooled one. If your provider doesn't
# pool connections, this can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/workorders"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Optional integrations (each degrades gracefully when unset: logs and skips) ---

# Email via nodemailer (Gmail)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Telegram bot notifications
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Protects the /api/pm-schedules/generate and /api/maintenance-contracts/check-alerts
# cron endpoints (checked via `Authorization: Bearer <token>`, not session auth)
CRON_SECRET=""

# Vercel Blob, for photo uploads
BLOB_READ_WRITE_TOKEN=""
